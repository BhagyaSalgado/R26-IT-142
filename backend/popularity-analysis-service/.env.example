# Application
APP_NAME="Movie Trailer Popularity Metrics Service"
APP_ENV=development
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Firebase / Firestore
# true  = use local in-memory repository, no Firebase credentials required
# false = use real Firebase Firestore through Firebase Admin SDK
FIREBASE_MOCK_MODE=true
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CREDENTIALS_PATH="serviceAccountKey.json"

# Optional Firestore emulator example:
# FIRESTORE_EMULATOR_HOST="localhost:8080"

# YouTube Data API
# Leave empty for simulated trailer metrics.
YOUTUBE_API_KEY=""
YOUTUBE_API_TIMEOUT_SECONDS=10

# ML simulation / model metadata
MODEL_NAME="SimulatedPopularityClassifier"
MODEL_VERSION="v0.1-simulated"
