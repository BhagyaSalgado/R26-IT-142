# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Model Configuration
# Popular Pretrained Options:
# - distilbert-base-uncased-finetuned-sst-2-english (General sentiment)
# - cardiffnlp/twitter-roberta-base-sentiment-latest (Twitter sentiment)
# - bert-base-uncased (General BERT)
# - distilbert-base-uncased (Lightweight BERT)
PRIMARY_MODEL=distilbert-base-uncased-finetuned-sst-2-english
SECONDARY_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
USE_FALLBACK=true

# Firebase
FIREBASE_CREDENTIALS=/path/to/firebase-config.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# YouTube API
YOUTUBE_API_KEY=your-api-key-here

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
