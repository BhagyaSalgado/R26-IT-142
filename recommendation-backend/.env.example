APP_NAME="Movie Trailer Recommendation Engine"
EMOTION_API_BASE_URL="http://127.0.0.1:8000"
EMOTION_OUTPUT_DIR=""
POPULARITY_API_BASE_URL="http://127.0.0.1:8001"
CORS_ORIGINS="http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174"
ALLOW_ANONYMOUS_ACCESS=false
FIREBASE_CREDENTIALS_PATH="firebase-service-account.json"
FIREBASE_PROJECT_ID="movie-trailer-analyzer"
FIREBASE_COLLECTION="trailer_recommendations"
FIRESTORE_TIMEOUT_SECONDS=5.0

# Real, data-trained genre model (LMTD-9, 4,021 real movies). Needs a free
# OMDb API key (http://www.omdbapi.com/apikey.aspx) to fetch each movie's
# plot/cast/director/ratings by trailer title. Without this key, genre
# classification falls back to the rule-based scene-evidence estimate and
# says so honestly in the response (trailer_profile.genre_source).
OMDB_API_KEY=""

# Real, unique per-scene fix text generated live by Claude from the real
# detected evidence, instead of picking from a fixed phrase template. Get a
# key at https://console.anthropic.com/settings/keys. Without one, fix text
# falls back to the template system (still genre-aware, just not uniquely
# worded per scene).
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
